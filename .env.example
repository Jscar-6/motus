# Copy to .env and fill in. Never commit .env.

# TRSP download via kagglehub (D1). Alternatively use ~/.kaggle/kaggle.json.
KAGGLE_USERNAME=
KAGGLE_KEY=

# Gemini session report (F6, stretch) and live coach (F10). Stays on the server.
GEMINI_API_KEY=
# Model for the F10 coach; any Gemini text model id works.
GEMINI_MODEL=gemini-2.5-flash

# F11 recordings database (Supabase). Put these two in web/.env.local (Vite reads web/), never commit it.
# Supabase Dashboard → Project Settings → API: Project URL and the anon public key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
